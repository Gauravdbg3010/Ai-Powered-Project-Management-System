# ==============================================================================
# TaskFlow Environment Configuration Example
# Copy this file to .env and adjust variables as needed
# ==============================================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/taskflow_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Security & JWT Token Configuration
# Must be at least 256 bits (32 bytes) for HMAC-SHA256
JWT_SECRET=c2VjdXJpdHktc2VjcmV0LWtleS1mb3ItdGFza2Zsb3ctcHJvamVjdC1tdXN0LWJlLTI1NmJpdHM=
JWT_EXPIRATION_MS=86400000

# Server Port
PORT=8080

# Spring AI Configuration (OpenAI or compatible provider)
# If empty, TaskFlow automatically uses deterministic, high-quality heuristic AI fallbacks
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# TaskFlow Frontend Environment Variables
# In local development, leave this commented out or set to /api (Vite dev server proxies to http://localhost:8080)
# VITE_API_BASE_URL=/api

# In production (Vercel), set this variable to your publicly deployed backend API URL:
# Examples:
#   VITE_API_BASE_URL=https://taskflow-api.onrender.com/api
#   VITE_API_BASE_URL=https://your-app.railway.app/api
#   VITE_API_BASE_URL=https://your-subdomain.loca.lt/api
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api

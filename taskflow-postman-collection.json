{
  "info": {
    "name": "TaskFlow AI Project Management API",
    "description": "Production REST API for TaskFlow - AI-Powered Project & Task Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "jwtToken", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Employee",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor\",\n  \"email\": \"sarah@taskflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register" }
          }
        },
        {
          "name": "Login (Manager)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@taskflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me" }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List Projects (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/projects?page=0&size=10&status=ACTIVE" }
          }
        },
        {
          "name": "Get Project By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/projects/1" }
          }
        },
        {
          "name": "Create Project (Manager Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Real-Time Logistics Engine\",\n  \"description\": \"GPS tracking, routing optimization, and fleet dispatching\",\n  \"status\": \"PLANNING\",\n  \"startDate\": \"2026-11-01\",\n  \"endDate\": \"2027-02-28\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects" }
          }
        },
        {
          "name": "Archive Project",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/projects/1/archive" }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Get Project Tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/projects/1/tasks" }
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement Kafka Event Publisher\",\n  \"description\": \"Publish event streams when transfers complete\",\n  \"priority\": \"HIGH\",\n  \"dueDate\": \"2026-11-15\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects/1/tasks" }
          }
        },
        {
          "name": "Get My Tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/tasks/my" }
          }
        },
        {
          "name": "Update Task Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks/1/status" }
          }
        },
        {
          "name": "Update Task Progress",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progress\": 75\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks/1/progress" }
          }
        }
      ]
    },
    {
      "name": "Dependencies",
      "item": [
        {
          "name": "Get Task Dependencies",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/tasks/3/dependencies" }
          }
        },
        {
          "name": "Add Dependency (Prevents Cycles)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/tasks/3/dependencies/2" }
          }
        }
      ]
    },
    {
      "name": "Dashboards",
      "item": [
        {
          "name": "Manager Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/manager" }
          }
        },
        {
          "name": "Employee Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/employee" }
          }
        }
      ]
    },
    {
      "name": "AI Engineering",
      "item": [
        {
          "name": "Generate AI Task Plan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectDescription\": \"Deploy automated zero-downtime microservices\",\n  \"objectives\": \"Canary deployments, automatic rollbacks, distributed tracing\",\n  \"techStack\": \"Spring Boot, Docker, Kubernetes, Istio\",\n  \"deadline\": \"3 weeks\",\n  \"teamContext\": \"2 DevOps, 2 Backend Engineers\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ai/projects/1/task-plan" }
          }
        },
        {
          "name": "Get AI Project Risk Analysis",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/ai/projects/1/risk" }
          }
        },
        {
          "name": "Get AI Progress Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/ai/projects/1/summary" }
          }
        },
        {
          "name": "Chat with AI Assistant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Which tasks are currently blocked or approaching deadlines?\",\n  \"projectId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/ai/assistant/chat" }
          }
        },
        {
          "name": "Get Task Implementation Plan",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/ai/tasks/1/implementation-plan" }
          }
        }
      ]
    }
  ]
}
